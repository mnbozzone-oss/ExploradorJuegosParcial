<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ExploradorJuegos.MainPage"
    xmlns:viewmodels="clr-namespace:ExploradorJuegos.ViewModels"
    xmlns:models="clr-namespace:ExploradorJuegos.Models"
    x:DataType="viewmodels:MainViewModel"
    Title="Explorador de juegos">

    
    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,Auto,*"
        RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label
                Text="Explorador de juegos"
                FontSize="26"
                FontAttributes="Bold" />

            <Label
                Text="Descubrí juegos gratuitos para PC y navegador."
                FontSize="14" />
        </VerticalStackLayout>


        <Button
            Grid.Row="1"
            Text="Cargar juegos"
            Command="{Binding CargarJuegosCommand}" />


    <Label
            Grid.Row="2"
            Text="{Binding Mensaje}"
            FontSize="14" />

    <ActivityIndicator
            Grid.Row="3"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center" />

    <CollectionView
            Grid.Row="4"
            ItemsSource="{Binding Juegos}"
            SelectionMode="None">   
    

   <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="models:Juego">
            <Border
                   Padding="12"
                   Margin="0,0,0,10"
                   Stroke="#808080"
                   StrokeShape="RoundRectangle 8">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="{Binding Nombre}"
                                FontSize="18"
                                FontAttributes="Bold" />

            <Label
                 Text="{Binding Genero}"
                                FontSize="14" />

            <Label
                 Text="{Binding Plataforma}"
                                FontSize="13" />
        </VerticalStackLayout>
       </Border>
     </DataTemplate>
    </CollectionView.ItemTemplate>
   </CollectionView>
  </Grid>
</ContentPage>
